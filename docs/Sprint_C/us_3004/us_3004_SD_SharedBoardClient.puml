@startuml
autonumber
title ShareBoard - SharedBoardClient

actor "User" as User

participant ": ShareBoardUI" as UI <<ShareBoardClient>> <<Presentation>>
participant ": SBPMessageFormat" as SBPF
participant ": DataOutputStream" as DOS
participant ": DataInputStream" as DIS
activate User
User -> UI : chooses board, permission and \nparticipant email
activate UI

UI -> UI : sendShareBoardRequest(boardId, email, permission)
activate UI
UI -> SBPF : createShareBoardRequest(boardId, email, permission)
activate SBPF
return shareBoardRequest
UI -> DOS : create(socket)
activate DOS
deactivate DOS
UI -> DIS : create(socket)
activate DIS
deactivate DIS
UI -> DOS : writeUTF(shareBoardRequest)
activate DOS
return DOS
UI -> DIS : readUTF()
activate DIS
return message
return true
return : informs operation success
deactivate UI
@enduml