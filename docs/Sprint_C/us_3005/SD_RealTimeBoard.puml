@startuml
'https://plantuml.com/sequence-diagram

autonumber

actor user

participant "ViewInRealTimeUI" as ui <<ShareBoardClient>> <<Presentation>>
participant "ServerSocket" as ss
participant "SBPMessageFormat" as sbpf
participant "ViewInRealTimeRequest" as request
participant "DataOutputStream" as dos
participant "DataInputStream" as dis
participant "HTTPmessage" as message

activate user

user -> ui: selects the board, ip, the port and asks to view updates
activate ui


ui -> ss: create(port,50,ip)
activate ss
return sock
ui -> ss: accept()
activate ss
return cliSocket


ui -> sbpf: createViewInRealTimeRequest(boardId)
activate sbpf
sbpf --> ui: viewInRealTimeRequest
deactivate sbpf
ui -> dos: writeUTF(viewInRealTimeRequest)
activate dos
deactivate dos
ui -> dis : readUTF()
activate dis
note right : for more information check SD_BoardInformation
dis --> ui: boardInfo
deactivate dis

ui -> sbpf: decodeDTO(boardInfo)
activate sbpf
return boardCellsInfo

ui -> request : create(cliSocket, BaseFolder, boardCellsInfo, boardId)
ui -> request : start()
activate request
request -> dis: create
request -> dos: create

request -> request: getTableInHTML()
activate request
return content

request -> message: setContentFromString(content,"text/html");
request -> message: setResponseStatus("200 Ok");
request -> message: send (outS);



deactivate ui

deactivate user
@enduml