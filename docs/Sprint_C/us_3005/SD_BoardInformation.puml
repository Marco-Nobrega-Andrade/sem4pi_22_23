@startuml
'https://plantuml.com/sequence-diagram

autonumber

autonumber
title ShareBoard - SharedBoardServer

participant "AttendClient" as ac <<Application>>
participant "DataInputStream" as dis
participant "DataOutputStream" as dos
participant "SBPMessageFormat" as sbp
participant "BoardInformationController" as ctrl <<ShareBoardServer>> <<Application>>
participant "BoardInformationService" as bis <<Service>>
participant "CellDTOWithColumnRowContentMapper" as ma <<DTO>>
participant "CellDTOWithColumnRowContentBuilder" as builder <<DTO>>
participant "CellDTOWithColumnRowContent" as dto <<DTO>>
database "BoardRepository" as br <<Repository>>

activate ac
ac -> dis : create(socket)
activate dis
deactivate dis
ac -> dos : create(socket)
activate dos
deactivate dos
ac -> dis : readUTF()
activate dis
return message
ac -> sbp : decodeFormat(message)
activate sbp
return arrayFormat
ac -> sbp : decodeParams(message)
activate sbp
return params
ac -> ctrl : getBoardInformation(boardId)
activate ctrl
ctrl -> bis : getBoardCellsInformation(boardId)
activate bis
bis -> br : findBoardByTitle(boardId)
activate br
return board
bis -> br : getAllCellsFromABoard(board)
activate br
br --> bis: listCells
deactivate br
loop for each cell in cellList
bis -> ma: toDto(cell)
activate ma
ma -> builder: build()
activate builder
builder -> dto: create(rowIdentifier,rowTitle,columnIdentifier,columnTitle,content)
activate dto
return cellDTOWithColumnRowContent
return cellDTOWithColumnRowContent
return cellDTOWithColumnRowContent
end

bis --> ctrl: listCellDTOWithColumnRowContent
deactivate bis
ctrl --> ac : listCellDTOWithColumnRowContent
deactivate ctrl
ac -> sbp : createBoardInfoRequest(listCellDTOWithColumnRowContent)
activate sbp
return boardInfoRequest
ac -> dos : writeUTF(boardInfoRequest)
activate dos
deactivate dos
deactivate ac
@enduml