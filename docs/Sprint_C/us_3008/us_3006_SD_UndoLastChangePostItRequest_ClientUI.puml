@startuml
'https://plantuml.com/sequence-diagram

autonumber

actor Person

participant "createPostItUI" as UI <<presentation>>
participant "createPostItController" as Controller <<application>>
participant "createPostItService" as Service <<application>>

participant "PersistenceContext" as Persistence <<persistence>>
participant "RepositoryFactory" as Factory <<factory>>

participant "PostItFactory" as PostItFactory <<factory>>

participant "PostIt" as PostIt <<domain>>
participant "Cell" as Cell <<domain>>
participant "Board" as Board <<domain>>

database "PostItRepository" as PostItRepository <<repository>>
database "BoardRepository" as BoardRepository <<repository>>

activate Person
activate UI

Person -> UI : wants to create a post-it
UI -> Controller : undoLastPostIt(int column, int row)
activate Controller
Controller -> Service : undoLastPostIt(int column, int row)
activate Service

Service -> Persistence : repositories()
activate Persistence
Persistence -> Factory : create
Persistence -> Service : factory
deactivate Persistence

Service -> Factory : postIts()
activate Factory
Factory -> PostItRepository : create
Factory -> Service: postItRepository
deactivate Factory

Service -> Factory : boards()
activate Factory
Factory -> PostItRepository : create
Factory -> Service : boardRepository
deactivate Factory

Service -> BoardRepository : findCell(int column, int row)
BoardRepository -> Service : board
Service -> PostItRepository : findVersionBeforeOfTheLastVersionOfPostIt(version-1, id)
PostItRepository -> Service : postIt
Service -> PostIt : incrementVersion()
Service -> Board : addPostIt(postIt)
Service -> PostItRepository : save(postIt)
Service -> BoardRepository : save(board)

Service -> Controller: true
deactivate Service
Controller -> UI: true
deactivate Controller
UI-> Person: success message

deactivate UI

@enduml