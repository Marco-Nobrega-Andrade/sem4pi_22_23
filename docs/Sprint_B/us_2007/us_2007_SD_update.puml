@startuml
autonumber
title Update Question

actor "Teacher" as T

participant ": AddUpdateQuestionUI" as UI <<Presentation>>
control "AddUpdateQuestionController" as CTRL <<Application>>
control "ListCourseController" as LCCTRL <<Application>>
control "ListCourseQuestionsController" as LCQCTRL <<Application>>
participant ": AddUpdateQuestionService" as AUQS <<Service>>

participant ": Question" as Q <<Domain>>
participant ": QuestionId" as QI <<Domain>>
participant ": VerifyQuestionService" as VQS <<Service>>
participant ": Structure" as St <<Domain>>
database QuestionRepository as QR <<Repository>>

activate T
T -> UI : asks to add/update an exam question to a repository
activate UI

UI->CTRL : listCourse()
activate CTRL
CTRL -> LCCTRL : listCourse()
note right: the continuation of this Use Case is in SD_ListCourses
activate LCCTRL
LCCTRL --> CTRL : courseDTOList
deactivate LCCTRL
CTRL --> UI : courseDTOList
deactivate CTRL
UI --> T : shows all courses and that a question can relate to
deactivate UI

T -> UI : picks a course and asks to update a question
activate UI


UI -> CTRL : listCourseQuestions(courseDTO)
activate CTRL
CTRL -> LCQCTRL : listCourseQuestions(courseDTO)
note right: the continuation of this Use Case is in SD_listCourseQuestion
activate LCQCTRL
LCQCTRL --> CTRL : courseDTOList
deactivate LCQCTRL
CTRL --> UI : questionDTOList
deactivate CTRL
UI --> T : shows all questions
deactivate UI
T -> UI : chooses a question and insert the \npath of the new version
activate UI

UI -> CTRL : updateQuestion(questionDTO, updatedQuestion)
activate CTRL

CTRL -> AUQS : updateQuestion(questionDTO, updatedQuestion)
activate AUQS
AUQS -> QI : create(questionDTO.questionId)
activate QI
deactivate QI
AUQS -> QR : ofIdentity(QuestionId)
activate QR
QR --> AUQS : question
deactivate QR
AUQS -> VQS : verifyQuestion(updatedQuestion)
activate VQS
VQS --> AUQS : true
deactivate VQS
AUQS -> St : create(updatedQuestion)
activate St
deactivate St
AUQS -> Q : changeQuestion(Structure)
activate Q
deactivate Q


AUQS -> QR : save(question)
activate QR
deactivate QR
deactivate AUQS
deactivate CTRL

UI--> T : informs operation success

@enduml