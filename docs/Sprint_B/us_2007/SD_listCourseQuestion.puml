@startuml
'https://plantuml.com/sequence-diagram

autonumber


control "ListCourseQuestionsController" as CTRL <<Application>>
participant ": AddUpdateQuestionService" as AUQS <<Service>>

participant ": CourseIdentifier" as CI <<Domain>>
participant ": QuestionMapper" as QM <<DTO>>
database QuestionRepository as QR <<Repository>>

CTRL -> AUQS : listCourseQuestions(courseDTO)
activate AUQS
AUQS -> CI : create(courseDTO.courseIdentifier)
activate CI
deactivate CI
AUQS -> QR : listQuestionsByCourseId(courseId)
activate QR
QR --> AUQS : questionList
deactivate QR
loop for each question in questionList
AUQS -> QM : toDTOWithId
activate QM
QM --> AUQS : questionDTO
deactivate QM
end loop
AUQS --> CTRL : questionDTOList
deactivate AUQS

@enduml