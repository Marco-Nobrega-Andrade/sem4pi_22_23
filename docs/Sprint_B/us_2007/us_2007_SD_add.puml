@startuml
autonumber
title Add Question

actor "Teacher" as T

participant ": AddQuestionUI" as UI <<Presentation>>
control "AddQuestionController" as CTRL <<Application>>
control "ListCourseController" as LCCTRL <<Application>>
participant ": AddUpdateQuestionService" as AUQS <<Service>>
participant ": QuestionBuilder" as QB <<Builder>>
participant ": VerifyQuestionService" as VQS <<Service>>
participant ": Question" as Q <<Domain>>
database QuestionRepository as QR <<Repository>>

activate T
T -> UI : asks to add/update an exam question to a repository
activate UI


UI -> CTRL : listCourse()
activate CTRL
CTRL->LCCTRL : listCourse()
note right: the continuation of this Use Case is in SD_ListCourses
activate LCCTRL
LCCTRL --> CTRL : courseDTOList
deactivate LCCTRL
CTRL --> UI :courseDTOList
deactivate CTRL


UI --> T : shows all courses and that a question can relate to
deactivate UI

T -> UI : picks a course, chooses to add a question \rand inserts the path of the file
activate UI

UI -> CTRL : addQuestion(questionStructure)
activate CTRL

CTRL -> AUQS : addQuestion(questionStructure)
activate AUQS

AUQS -> QR : count()
activate QR
QR --> AUQS : numberOfQuestions
deactivate QR
AUQS -> QB : withStructure(questionStructure)
activate QB
QB -> VQS : verifyQuestion(structure.ToString())
activate VQS
VQS --> QB : true
deactivate VQS
QB --> AUQS : questionBuilder
deactivate QB
AUQS -> QB : withIdentifier(id)
activate QB
QB --> AUQS : questionBuilder
deactivate QB
AUQS -> QB : build()
activate QB

QB -> Q : create(structure, id)
activate Q

deactivate Q
QB --> AUQS : question
deactivate QB


AUQS -> QR : save(question)
activate QR
deactivate QR
deactivate AUQS
deactivate CTRL

UI--> T : informs operation success

@enduml